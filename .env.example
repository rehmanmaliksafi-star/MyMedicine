# MyMedicine — copy to .env and fill in your own values. Never commit .env!
SECRET_KEY=your-django-secret-key-here
DEBUG=True
# Get a FREE Groq API key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# --- Easypaisa (Easypay) payment gateway ---
# Get these from your Easypaisa merchant account (apply at easypaisa.com.pk/business).
# Until real credentials are set, checkout uses the clearly-labelled sandbox
# simulator page so the payment flow can be tested with no real money moving.
# EASYPAY_SANDBOX=True uses https://easypaystg.easypaisa.com.pk (sandbox).
# Set EASYPAY_SANDBOX=False for live payments at https://easypay.easypaisa.com.pk.
EASYPAY_STORE_ID=YOUR_EASYPAY_STORE_ID
EASYPAY_HASH_KEY=YOUR_EASYPAY_HASH_KEY
# Merchant Easypaisa account number for settlement (optional).
EASYPAY_ACCOUNT_NO=
EASYPAY_SANDBOX=True
